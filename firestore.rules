rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isNullableString(value) {
      return value == null || value is string;
    }

    function isValidUserProfile(uid) {
      return request.resource.data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'createdAt',
          'lastLoginAt',
          'activeSaveId',
          'activeCampaignId',
          'campaignGeneration'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'createdAt',
          'lastLoginAt',
          'activeSaveId',
          'activeCampaignId',
          'campaignGeneration'
        ])
        && request.resource.data.uid == uid
        && isNullableString(request.resource.data.displayName)
        && isNullableString(request.resource.data.email)
        && isNullableString(request.resource.data.photoURL)
        && isNullableString(request.resource.data.activeCampaignId)
        && request.resource.data.campaignGeneration is int
        && request.resource.data.createdAt is timestamp
        && request.resource.data.lastLoginAt is timestamp
        && (
          request.resource.data.activeSaveId == null
          || (
            request.resource.data.activeSaveId is string
            && request.resource.data.activeSaveId.size() > 0
          )
        );
    }

    function isValidSave(uid, saveId) {
      return request.resource.data.keys().hasAll([
          'schemaVersion',
          'gameVersion',
          'revision',
          'updatedAt',
          'syncedAt',
          'payload',
          'campaignId',
          'campaignGeneration',
          'invalidated'
        ])
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'gameVersion',
          'revision',
          'updatedAt',
          'syncedAt',
          'payload',
          'campaignId',
          'campaignGeneration',
          'invalidated',
          'invalidatedAt',
          'resetEvent'
        ])
        && request.resource.data.schemaVersion is int
        && request.resource.data.gameVersion is string
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.updatedAt is string
        && request.resource.data.syncedAt is timestamp
        && request.resource.data.campaignId is string
        && request.resource.data.campaignGeneration is int
        && request.resource.data.invalidated is bool
        && request.resource.data.payload is map
        && request.resource.data.payload.ownerId == uid
        && request.resource.data.payload.saveId == saveId
        && request.resource.data.payload.campaignId == request.resource.data.campaignId
        && request.resource.data.payload.campaignGeneration == request.resource.data.campaignGeneration
        && (
          request.resource.data.invalidated == false
          || request.resource.data.keys().hasAll(['invalidatedAt', 'resetEvent'])
        );
    }

    match /users/{uid} {
      allow read: if ownsUser(uid);
      allow create: if ownsUser(uid) && isValidUserProfile(uid);
      allow update: if ownsUser(uid)
        && isValidUserProfile(uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.campaignGeneration >= resource.data.get('campaignGeneration', 0);
      allow delete: if false;

      match /saves/{saveId} {
        allow read: if ownsUser(uid);
        allow create: if ownsUser(uid) && isValidSave(uid, saveId);
        allow update: if ownsUser(uid)
          && isValidSave(uid, saveId)
          && (resource.data.get('invalidated', false) != true || request.resource.data.invalidated == true);
        allow delete: if false;
      }

      match /meta/{document=**} {
        allow read, write: if ownsUser(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
